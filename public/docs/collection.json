        {
            "name": "Firmware",
            "description": "\nGesti\u00f3n y descarga de archivos de firmware para los instrumentos.",
            "item": [
                {
                    "name": "Listar firmware",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/firmware\/list",
                            "query": [
                                {
                                    "key": "instrument",
                                    "value": "architecto",
                                    "description": "El nombre del instrumento (ej. IO-8).",
                                    "disabled": false
                                }
                            ],
                            "raw": "{{baseUrl}}\/api\/firmware\/list?instrument=architecto"
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": "Devuelve el \u00faltimo firmware estable y nightly para un instrumento espec\u00edfico.\nSi no se proporciona el par\u00e1metro 'instrument', devuelve la lista de instrumentos disponibles.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n\"instrument\": \"IO-8\",\n\"firmware\": {\n\"stable\": { \"id\": 1, \"version\": \"1.0.0\", \"description\": \"Lanzamiento estable\", \"size\": \"1.2 MB\", \"created_at\": \"2026-06-06\" },\n\"nightly\": { \"id\": 2, \"version\": \"1.1.0-beta\", \"description\": \"Versi\u00f3n en pruebas\", \"size\": \"1.2 MB\", \"created_at\": \"2026-06-07\" }\n}\n}",
                            "name": ""
                        },
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n\"instruments\": [\"IO-8\", \"IO-12\"]\n}",
                            "name": ""
                        }
                    ]
                },
                {
                    "name": "Descargar firmware",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/firmware\/:firmware_id\/download",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/firmware\/:firmware_id\/download",
                            "variable": [
                                {
                                    "id": "firmware_id",
                                    "key": "firmware_id",
                                    "value": "1",
                                    "description": "The ID of the firmware."
                                },
                                {
                                    "id": "firmware",
                                    "key": "firmware",
                                    "value": "16",
                                    "description": "El ID del registro de firmware."
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": "Inicia la descarga del archivo binario (.bin) asociado a un firmware espec\u00edfico.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{ \"binary\": \"file content\" }",
                            "name": ""
                        },
                        {
                            "header": [],
                            "code": 404,
                            "body": "{ \"message\": \"Archivo no encontrado\" }",
                            "name": ""
                        }
                    ]
                }
            ]
