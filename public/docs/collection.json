    "item": [
        {
            "name": "Administration",
            "description": "\nAPIs para la gesti\u00f3n administrativa del sistema (requiere privilegios).",
            "item": [
                {
                    "name": "Subir firmware",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/admin\/firmware\/upload",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/admin\/firmware\/upload"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "multipart\/form-data"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "instrument",
                                    "value": "architecto",
                                    "type": "text",
                                    "description": "Nombre del instrumento."
                                },
                                {
                                    "key": "version",
                                    "value": "architecto",
                                    "type": "text",
                                    "description": "Versi\u00f3n del firmware (ej. 1.0.0)."
                                },
                                {
                                    "key": "channel",
                                    "value": "architecto",
                                    "type": "text",
                                    "description": "Canal de despliegue: \"stable\" o \"nightly\"."
                                },
                                {
                                    "key": "description",
                                    "value": "Eius et animi quos velit et.",
                                    "type": "text",
                                    "description": "optional Descripci\u00f3n del firmware."
                                },
                                {
                                    "key": "firmware",
                                    "src": [],
                                    "type": "file"
                                }
                            ]
                        },
                        "description": "Sube un archivo binario de firmware y registra sus metadatos en la base de datos."
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 201,
                            "body": "{\n\"message\": \"Firmware subido y registrado con \u00e9xito.\",\n\"firmware\": { \"id\": 1, \"instrument\": \"IO-8\", \"version\": \"1.0.0\", \"channel\": \"stable\", \"size_bytes\": 1024 }\n}",
                            "name": ""
                        }
                    ]
                },
